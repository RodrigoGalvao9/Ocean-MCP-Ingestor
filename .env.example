# Copie para .env e preencha. Nunca faça commit do .env.
# Valores vazios são ignorados (valem os padrões do código).

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Servidor MCP ---
# A API (ocean-agent-api) precisa usar o MESMO valor em MCP_AUTH_TOKEN.
# Em production o servidor se recusa a subir sem token.
MCP_AUTH_TOKEN=
MCP_HOST=0.0.0.0
PORT=8000

# --- Postgres (Neon ou Supabase; use sslmode=require na URL) ---
# Servidor MCP: usuário SOMENTE LEITURA. Ingestão (GitHub Actions): usuário admin.
DATABASE_URL=

# --- Redis (cache de clima etc.). No Render: Internal URL do Key Value ---
REDIS_URL=

# --- Qdrant Cloud + embeddings (Cloudflare) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ocean_conhecimento
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
FASTEMBED_CACHE_DIR=

# --- Fontes externas (fases seguintes) ---
GFW_TOKEN=
