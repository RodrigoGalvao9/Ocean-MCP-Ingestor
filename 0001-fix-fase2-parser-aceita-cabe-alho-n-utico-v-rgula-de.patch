 tests/test_dhn_tides_pdf.py                  | 40 ++++++++++++++++----
 2 files changed, 58 insertions(+), 19 deletions(-)

diff --git a/src/ocean/ingestion/parsers/dhn_tides_pdf.py b/src/ocean/ingestion/parsers/dhn_tides_pdf.py
